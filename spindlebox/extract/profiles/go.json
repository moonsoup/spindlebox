{
  "language": "go",
  "extensions": [".go"],
  "grammar": {"module": "tree_sitter_go", "attr": "language", "name": "go"},
  "walker": true,
  "builtins": ["append", "cap", "clear", "close", "complex", "copy", "delete", "imag", "len", "make", "max", "min", "new", "panic", "print", "println", "real", "recover"],
  "entry_points": {"names": ["main", "init"], "prefixes": ["Test", "Benchmark", "Example", "Fuzz"], "file_contains": ["test"]},
  "mode": "nested",
  "boundaries": ["func_literal", "function_declaration", "method_declaration"],
  "imports": [{"node": "import_spec", "field": "path", "strip": "\""}],
  "calls": {
    "node": "call_expression",
    "field": "function",
    "pattern": "^[A-Za-z_][\\w]*(\\.[\\w]+)*$",
    "boundaries": ["func_literal"]
  },
  "doc": {},
  "declare": {
    "param_fields": ["parameters", "receiver"],
    "nodes": {
      "short_var_declaration": {"field": "left"},
      "var_spec": {"children": "identifier"},
      "range_clause": {"field": "left"}
    }
  },
  "writes": {
    "assign": ["assignment_statement"],
    "assign_field": "left",
    "assign_idents": "walk",
    "update": ["inc_statement", "dec_statement"]
  },
  "params": {
    "field": "parameters",
    "nodes": {
      "parameter_declaration": {
        "type_field": "type",
        "names_from_children": "identifier",
        "fallback": "arg{i}"
      },
      "variadic_parameter_declaration": {
        "type_field": "type",
        "names_from_children": "identifier",
        "first_only": true,
        "kind": "variadic",
        "fallback": "args"
      }
    }
  },
  "declarations": {
    "function_declaration": {
      "kind": "function",
      "name": {"field": "name"},
      "returns": {"field": "result"},
      "state": "pure"
    },
    "method_declaration": {"handler": "go_method"},
    "func_literal": {
      "kind": "closure",
      "name": "<closure>",
      "returns": {"field": "result"},
      "capture": "closure",
      "floor": "reads_captured",
      "recurse_scope": "same"
    }
  },
  "returns_norm_hook": "go_multi_return",
  "meta": {
    "decorators": {"absent": "Go has no decorator, annotation or attribute syntax on functions."},
    "parent": {},
    "takes_fn": {"fn_types": ["(^|[^\\w])func\\s*\\("]},
    "returns_fn": {"fn_types": ["(^|[^\\w])func\\s*\\("], "return_nodes": ["return_statement"], "unwrap": ["expression_list", "parenthesized_expression"]},
    "param_calls": {},
    "table_calls": {"calls": [{"node": "call_expression", "callee": "function", "subscript": "index_expression", "object": "operand"}, {"node": "type_conversion_expression", "callee": "type", "subscript": "generic_type", "object": "type", "require_declared": true}]}
  },
  "fn_tables": {"declarations": [{"node": "var_spec", "name": "name", "value": "value"}], "unwrap": {"expression_list": null, "composite_literal": "body", "literal_element": null, "unary_expression": "operand"}, "containers": {"literal_value": {"entries": {"keyed_element": {"key": "key", "value": "value"}}}}, "members": ["identifier"], "keys": {"interpreted_string_literal": "str", "raw_string_literal": "str", "int_literal": "int"}},
  "datatypes": {"records": [{"node": "type_spec", "name": "name", "type_params": "type_parameters", "require": {"type": "struct_type"}, "fields": ["type", 0]}], "fields": {"field_declaration_list": {"node": ["field_declaration"], "name": "name", "type": "type", "embedded": true}}, "type_params": {"type_parameter_declaration": "name"}, "hooks": ["go_const_enums", "go_sealed_interfaces"]}
}
