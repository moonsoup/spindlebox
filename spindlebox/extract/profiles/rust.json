{
  "language": "rust",
  "extensions": [".rs"],
  "grammar": {"module": "tree_sitter_rust", "attr": "language", "name": "rust"},
  "walker": true,
  "builtins": ["Some", "Ok", "Err", "drop", "Box", "String", "Vec", "Option", "Result", "Default", "From", "Into", "TryFrom", "TryInto", "ToString", "ToOwned", "Clone", "Iterator", "IntoIterator", "FromIterator", "Extend", "AsRef", "AsMut", "PartialEq", "Eq", "PartialOrd", "Ord", "Fn", "FnMut", "FnOnce", "DoubleEndedIterator", "ExactSizeIterator"],
  "entry_points": {"names": ["main"], "prefixes": ["test_"], "file_contains": ["test"]},
  "mode": "nested",
  "boundaries": ["function_item", "closure_expression"],
  "imports": [{"node": "use_declaration", "field": "argument"}],
  "calls": {
    "node": "call_expression",
    "field": "function",
    "pattern": "^[A-Za-z_][\\w:]*(\\.[\\w]+)*$",
    "boundaries": ["closure_expression"],
    "replace": {"::": "."}
  },
  "doc": {"types": ["line_comment", "block_comment"]},
  "declare": {
    "param_fields": ["parameters"],
    "nodes": {
      "let_declaration": {"field": "pattern"}
    }
  },
  "writes": {
    "assign": ["assignment_expression", "compound_assignment_expr"],
    "assign_field": "left",
    "assign_idents": "single"
  },
  "params": {
    "field": "parameters",
    "nodes": {
      "self_parameter": {"name_literal": "self", "type_from_text": true, "kind": "receiver"},
      "parameter": {"type_field": "type", "name_field": "pattern", "fallback": "arg{i}"},
      "identifier": {"bare_text": true}
    }
  },
  "containers": {
    "impl_item": {
      "role": "class", "name_field": "type",
      "name_strip_generics": true, "name_missing": "<impl>",
      "scope_skip_duplicate": true
    },
    "mod_item": {"role": "module", "name_field": "name"}
  },
  "declarations": {
    "function_item": {"handler": "rust_function_item"},
    "closure_expression": {"handler": "rust_closure"}
  },
  "is_async_hook": "rust_is_async",
  "meta": {
    "decorators": {"siblings": ["attribute_item"], "strip": ["^#\\[", "\\]$"]},
    "parent": {},
    "takes_fn": {"fn_types": ["\\b(Fn|FnMut|FnOnce)\\s*\\(", "(^|[^\\w])fn\\s*\\("]},
    "returns_fn": {"fn_types": ["\\b(Fn|FnMut|FnOnce)\\s*\\(", "(^|[^\\w])fn\\s*\\("], "return_nodes": ["return_expression"]},
    "param_calls": {},
    "table_calls": {"calls": [{"node": "call_expression", "callee": "function", "subscript": "index_expression", "object": null}]}
  },
  "fn_tables": {"declarations": [{"node": "static_item", "name": "name", "value": "value"}, {"node": "const_item", "name": "name", "value": "value"}], "unwrap": {"reference_expression": "value"}, "containers": {"array_expression": {"entries": {"tuple_expression": {"key": 0, "value": -1}}}}, "members": ["identifier"], "keys": {"string_literal": "str", "integer_literal": "int"}},
  "datatypes": {"records": [{"node": "struct_item", "name": "name", "type_params": "type_parameters", "fields": "body"}], "enums": [{"node": "enum_item", "name": "name", "type_params": "type_parameters", "body": "body", "variants": {"enum_variant": {"name": "name", "fields": "body"}}}], "fields": {"field_declaration_list": {"node": ["field_declaration"], "name": "name", "type": "type"}, "ordered_field_declaration_list": {"positional": "type"}}, "type_params": {"type_parameter": "name", "constrained_type_parameter": "left", "type_identifier": null}, "scopes": ["mod_item"]}
}
