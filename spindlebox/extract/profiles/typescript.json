{
  "language": "typescript",
  "extensions": [
    ".ts",
    ".tsx"
  ],
  "grammar": {
    "module": "tree_sitter_typescript",
    "attr": "language_typescript",
    "name": "typescript",
    "by_suffix": {
      ".tsx": "tsx"
    }
  },
  "walker": true,
  "builtins": ["Array", "ArrayBuffer", "BigInt", "Boolean", "DataView", "Date", "Error", "EvalError", "Float32Array", "Float64Array", "Function", "Int8Array", "Int16Array", "Int32Array", "Intl", "JSON", "Map", "Math", "Number", "Object", "Promise", "Proxy", "RangeError", "ReferenceError", "Reflect", "RegExp", "Set", "String", "Symbol", "SyntaxError", "TypeError", "URIError", "Uint8Array", "Uint8ClampedArray", "Uint16Array", "Uint32Array", "WeakMap", "WeakRef", "WeakSet", "decodeURI", "decodeURIComponent", "encodeURI", "encodeURIComponent", "eval", "globalThis", "isFinite", "isNaN", "parseFloat", "parseInt", "queueMicrotask", "setTimeout", "setInterval", "clearTimeout", "clearInterval", "structuredClone", "fetch", "console", "require"],
  "entry_points": {"names": ["main"], "file_contains": ["test"]},
  "mode": "nested",
  "boundaries": [
    "function_declaration",
    "generator_function_declaration",
    "function_expression",
    "generator_function",
    "arrow_function",
    "method_definition"
  ],
  "imports_hook": "js_imports",
  "init_declared_hook": "js_module_declared",
  "calls": {
    "node": "call_expression",
    "field": "function",
    "pattern": "^[A-Za-z_$][\\w$]*(\\.[\\w$]+)*$",
    "boundaries": [
      "function_declaration",
      "generator_function_declaration",
      "function_expression",
      "generator_function",
      "arrow_function",
      "method_definition"
    ]
  },
  "doc": {
    "hook": "js_doc"
  },
  "declare": {
    "param_fields": [
      "parameters",
      "parameter"
    ],
    "nodes": {
      "variable_declarator": {
        "field": "name",
        "ident_types": [
          "identifier",
          "shorthand_property_identifier_pattern"
        ]
      },
      "function_declaration": {
        "name_field_direct": "name"
      }
    }
  },
  "writes": {
    "assign": [
      "assignment_expression",
      "augmented_assignment_expression"
    ],
    "assign_field": "left",
    "assign_idents": "single",
    "update": [
      "update_expression"
    ],
    "update_field": "argument"
  },
  "params": {
    "hook": "js_params"
  },
  "containers": {
    "class_declaration": {
      "role": "class",
      "name_field": "name",
      "name_missing": "<class>"
    },
    "class": {
      "role": "class",
      "name_field": "name",
      "name_missing": "<class>"
    }
  },
  "declarations": {
    "function_declaration": {
      "handler": "js_function"
    },
    "generator_function_declaration": {
      "handler": "js_function"
    },
    "function_expression": {
      "handler": "js_function"
    },
    "generator_function": {
      "handler": "js_function"
    },
    "arrow_function": {
      "handler": "js_function"
    },
    "method_definition": {
      "handler": "js_function"
    }
  },
  "is_async": {
    "child_type": "async"
  },
  "meta": {
    "decorators": {"siblings": ["decorator"], "children": ["decorator"], "strip": ["^@"]},
    "parent": {},
    "takes_fn": {"fn_types": ["=>", "\\bFunction\\b"]},
    "returns_fn": {"fn_types": ["=>", "\\bFunction\\b"], "return_nodes": ["return_statement"], "unwrap": ["parenthesized_expression"]},
    "param_calls": {},
    "table_calls": {"calls": [{"node": "call_expression", "callee": "function", "subscript": "subscript_expression", "object": "object"}], "receiver_names": ["this"]}
  },
  "fn_tables": {"declarations": [{"node": "variable_declarator", "name": "name", "value": "value"}], "unwrap": {"parenthesized_expression": null, "as_expression": null, "satisfies_expression": null}, "containers": {"object": {"entries": {"pair": {"key": "key", "value": "value"}}}, "array": {}}, "members": ["identifier"], "keys": {"property_identifier": "str", "string": "str", "number": "int"}},
  "datatypes": {"records": [{"node": "interface_declaration", "name": "name", "type_params": "type_parameters", "fields": "body"}, {"node": "type_alias_declaration", "name": "name", "type_params": "type_parameters", "require": {"value": "object_type"}, "fields": "value"}], "enums": [{"node": "enum_declaration", "name": "name", "body": "body", "variants": {"property_identifier": {"name": null}, "enum_assignment": {"name": "name"}}}], "unions": [{"node": "type_alias_declaration", "name": "name", "type_params": "type_parameters", "require": {"value": "union_type"}, "members": "value", "flatten": ["union_type"], "refs": ["type_identifier"], "inline": ["object_type"], "tags": ["literal_type"]}], "fields": {"interface_body": {"node": ["property_signature"], "name": "name", "type": ["type", 0], "optional_mark": "?", "optional_spelling": "{} | undefined"}, "object_type": {"node": ["property_signature"], "name": "name", "type": ["type", 0], "optional_mark": "?", "optional_spelling": "{} | undefined"}}, "type_params": {"type_parameter": "name"}, "scopes": ["internal_module", "module"]}
}
